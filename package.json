{
  "name": "bro-chase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bro Chase: brain-rot co-op survival horror in the browser",
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "proto": "vite --config proto/engines/vite.config.ts",
    "proto:build": "vite build --config proto/engines/vite.config.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.21.2",
    "three": "^0.170.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@babylonjs/core": "^9.33.1",
    "@babylonjs/loaders": "^9.33.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
